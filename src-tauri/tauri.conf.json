{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Valkyrie Control",
  "version": "0.1.0",
  "identifier": "io.github.jgsphaela.valkyrie-control",
  "build": {
    "beforeDevCommand": "node scripts/dev-server.mjs",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "node scripts/stage-web.mjs",
    "frontendDist": "../dist-web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Valkyrie Control",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 680,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
